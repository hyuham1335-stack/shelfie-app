# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (TRD 6.5)
# console.anthropic.com 에서 발급하고 크레딧을 충전한다.
# 비워 두면 services/ 가 목업 픽스처를 반환하는 로컬 개발 모드로 동작한다.
ANTHROPIC_API_KEY=

# 알라딘 OpenAPI TTB 키 (무료 발급, 사이트 주소 등록 필요)
ALADIN_TTB_KEY=

# 모델 교체용 운영 스위치. 비워 두면 claude-opus-5 를 쓴다.
MODEL_EXTRACT=claude-opus-5
MODEL_RECOMMEND=claude-opus-5

# 클라이언트 노출 가능 (서버에서 재검증한다)
NEXT_PUBLIC_MAX_PHOTOS=5
