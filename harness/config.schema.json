{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "harness config",
  "description": "프로젝트 고유 지식이 사는 유일한 파일. 스크립트·페이즈 파일에는 고유명사를 남기지 않는다. scripts/harness.py 의 자체 검증기가 이 스키마를 해석하므로 아래 키워드만 쓴다: type · enum · required · properties · additionalProperties · items · minItems · minimum · maximum · pattern · $ref(로컬) · definitions · title · description. 인스턴스에서 밑줄(_)로 시작하는 키는 주석으로 보고 additionalProperties 검사에서 제외한다.",
  "type": "object",
  "required": ["schema", "project", "adapter", "contract", "vcs", "roles", "primary_role"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "config 형식 버전. 형식이 깨지는 변경을 할 때만 올린다.",
      "type": "integer",
      "enum": [1]
    },
    "project": {
      "type": "object",
      "required": ["name", "language", "instruction_file"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "language": {
          "description": "생성물(보고서·PR 본문·에스컬레이션)의 언어. 파서는 어느 언어에서도 헤딩 텍스트에 의존하지 않는다.",
          "type": "string",
          "enum": ["ko", "en"]
        },
        "instruction_file": {"type": "string"},
        "instruction_slot_budget": {
          "description": "instruction_file 에 산문 규칙을 몇 칸까지 둘 수 있는가. 기계로 막을 수 있는 규칙의 산문 승격을 막는 예산.",
          "type": "integer",
          "minimum": 0
        },
        "rules_dir": {"type": "string"},
        "secret_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "adapter": {
      "description": "harness/adapters/{id}.json 의 id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "contract": {
      "type": "object",
      "required": ["path_template", "sections", "required"],
      "additionalProperties": false,
      "properties": {
        "path_template": {"type": "string"},
        "sections": {
          "description": "계약 문서의 절 제목. 파서 계약이지만 제목 자체는 프로젝트의 언어·어휘에 속한다. harness/templates/contract.md 와 일치해야 하고 doctor 가 그 일치를 검사한다.",
          "type": "object",
          "required": ["units", "entrypoints", "errors"],
          "additionalProperties": false,
          "properties": {
            "units": {"type": "string"},
            "entrypoints": {"type": "string"},
            "errors": {"type": "string"},
            "schema": {"type": "string"},
            "boundaries": {"type": "string"}
          }
        },
        "required": {
          "description": "계약 문서에 반드시 있어야 하는 절의 키.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["units", "entrypoints", "errors", "schema", "boundaries"]}
        }
      }
    },
    "vcs": {
      "type": "object",
      "required": ["forge", "remote", "base_branch", "branch_pattern"],
      "additionalProperties": false,
      "properties": {
        "forge": {"type": "string", "enum": ["github"]},
        "remote": {"type": "string"},
        "base_branch": {"type": "string"},
        "branch_pattern": {"type": "string"},
        "protected": {"type": "array", "items": {"type": "string"}},
        "pr_template": {"type": "string"}
      }
    },
    "roles": {
      "description": "N인. 2인 고정이 아니다. owns 에서 excludes 를 뺀 실효 집합이 서로 겹치면 doctor 가 거부한다.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/role"}
    },
    "primary_role": {
      "description": "귀속이 ambiguous 일 때의 시작점. roles[].id 중 하나여야 한다.",
      "type": "string"
    },
    "main_owned_paths": {
      "description": "메인 에이전트 단독 소유. 워커가 만지지 않는다 — 하네스 자신·문서·설정.",
      "type": "array",
      "items": {"type": "string"}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files_max": {"type": "integer", "minimum": 1},
        "lines_max": {"type": "integer", "minimum": 1},
        "model_calls_max": {"type": "integer", "minimum": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "small_max_units": {"type": "integer", "minimum": 1},
        "inv_skip_below_chars": {"type": "integer", "minimum": 0}
      }
    },
    "background_threshold_sec": {
      "description": "전체 회귀를 백그라운드로 돌릴 기준. 상수가 아니라 calibration.full.sec 과 비교하는 임계값이다.",
      "type": "integer",
      "minimum": 0
    },
    "calibration_file": {"type": "string"}
  },
  "definitions": {
    "role": {
      "type": "object",
      "required": ["id", "agent", "code", "owns"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "agent": {"type": "string"},
        "code": {
          "description": "경로·보고서에 쓰는 축약 코드. 경로 240자 상한 때문에 짧게 유지한다.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{0,7}$"
        },
        "owns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excludes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
